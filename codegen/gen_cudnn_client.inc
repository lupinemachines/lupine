      rpc_write(conn, &bDesc, sizeof(const cudnnTensorDescriptor_t)) < 0 ||
      rpc_write(conn, &B, sizeof(const void *)) < 0 ||
      rpc_write(conn, &beta_width, sizeof(beta_width)) < 0 ||
      (beta_width == 0 && rpc_write(conn, &beta, sizeof(beta)) < 0) ||
      (beta_width != 0 && rpc_write(conn, beta, beta_width) < 0) ||
      rpc_write(conn, &cDesc, sizeof(const cudnnTensorDescriptor_t)) < 0 ||
      rpc_write(conn, &C, sizeof(void *)) < 0 ||
