      rpc_write(conn, &handle, sizeof(cudnnHandle_t)) < 0 ||
      rpc_write(conn, &opTensorDesc, sizeof(const cudnnOpTensorDescriptor_t)) <
          0 ||
      rpc_write(conn, &alpha1_width, sizeof(alpha1_width)) < 0 ||
      (alpha1_width == 0 && rpc_write(conn, &alpha1, sizeof(alpha1)) < 0) ||
      (alpha1_width != 0 && rpc_write(conn, alpha1, alpha1_width) < 0) ||
      rpc_write(conn, &aDesc, sizeof(const cudnnTensorDescriptor_t)) < 0 ||
      rpc_write(conn, &A, sizeof(const void *)) < 0 ||
