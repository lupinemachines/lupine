static curandStatus_t lupine_rpc_curandGeneratePoissonMethod(
    conn_t *conn, curandGenerator_t generator, unsigned int *outputPtr,
    size_t n, double lambda, curandMethod_t method) {
  curandStatus_t return_value = rpc_error();
  uint32_t outputPtr_width =
      outputPtr != nullptr && scalar_on_host(generator, "outputPtr")
          ? static_cast<uint32_t>(n * sizeof(*outputPtr))
          : 0;
  if (conn == nullptr ||
      rpc_write_start_request(conn, RPC_curandGeneratePoissonMethod) < 0 ||
      rpc_write(conn, &generator, sizeof(curandGenerator_t)) < 0 ||
      rpc_write(conn, &outputPtr_width, sizeof(outputPtr_width)) < 0 ||
      (outputPtr_width == 0 &&
       rpc_write(conn, &outputPtr, sizeof(outputPtr)) < 0) ||
      rpc_write(conn, &n, sizeof(size_t)) < 0 ||
      rpc_write(conn, &lambda, sizeof(double)) < 0 ||
      rpc_write(conn, &method, sizeof(curandMethod_t)) < 0 ||
      rpc_wait_for_response(conn) < 0 ||
      (outputPtr_width != 0 &&
       rpc_read(conn, outputPtr, outputPtr_width) < 0) ||
      rpc_read(conn, &return_value, sizeof(return_value)) < 0 ||
      rpc_read_end(conn) < 0) {
    return rpc_error();
  }
  return return_value;
}

extern "C" curandStatus_t
curandGeneratePoissonMethod(curandGenerator_t generator,
                            unsigned int *outputPtr, size_t n, double lambda,
                            curandMethod_t method) {
  conn_t *conn = connection_for_handle(generator);
  return lupine_rpc_curandGeneratePoissonMethod(conn, generator, outputPtr, n,
                                                lambda, method);
}

