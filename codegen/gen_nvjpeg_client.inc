    conn_t *conn, nvjpegHandle_t handle, nvjpegEncoderState_t encoder_state,
    unsigned char *data, size_t *length, cudaStream_t stream) {
  nvjpegStatus_t return_value = rpc_error();
  size_t length_requested = (data != nullptr) ? *length : 0;
  uint8_t data_null = data == nullptr ? 1 : 0;
  if (conn == nullptr ||
      rpc_write_start_request(conn, RPC_nvjpegEncodeRetrieveBitstream) < 0 ||
      rpc_write(conn, &handle, sizeof(nvjpegHandle_t)) < 0 ||
      rpc_write(conn, &encoder_state, sizeof(nvjpegEncoderState_t)) < 0 ||
      rpc_write(conn, &length_requested, sizeof(size_t)) < 0 ||
      rpc_write(conn, &data_null, sizeof(uint8_t)) < 0 ||
      rpc_write(conn, &stream, sizeof(cudaStream_t)) < 0 ||
      rpc_wait_for_response(conn) < 0 ||
      rpc_read(conn, length, sizeof(size_t)) < 0 ||
      (data != nullptr && length_requested != 0 && *length != 0 &&
       rpc_read(conn, data,
                (*length < length_requested ? *length : length_requested) *
                    sizeof(unsigned char)) < 0) ||
      rpc_read(conn, &return_value, sizeof(return_value)) < 0 ||
      rpc_read_end(conn) < 0) {
    return rpc_error();
  }
