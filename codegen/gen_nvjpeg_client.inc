    nvjpegJpegState_t decoder_state, nvjpegImage_t *destination,
    cudaStream_t stream) {
  nvjpegStatus_t return_value = rpc_error();
  if (conn == nullptr ||
      rpc_write_start_request(conn, RPC_nvjpegDecodeJpegDevice) < 0 ||
      rpc_write(conn, &handle, sizeof(nvjpegHandle_t)) < 0 ||
      rpc_write(conn, &decoder, sizeof(nvjpegJpegDecoder_t)) < 0 ||
      rpc_write(conn, &decoder_state, sizeof(nvjpegJpegState_t)) < 0 ||
      rpc_write(conn, destination, sizeof(nvjpegImage_t)) < 0 ||
      rpc_write(conn, &stream, sizeof(cudaStream_t)) < 0 ||
      rpc_wait_for_response(conn) < 0 ||
      rpc_read(conn, &return_value, sizeof(return_value)) < 0 ||
      rpc_read_end(conn) < 0) {
    return rpc_error();
  }
  return return_value;
}

extern "C" nvjpegStatus_t
nvjpegDecodeJpegDevice(nvjpegHandle_t handle, nvjpegJpegDecoder_t decoder,
                       nvjpegJpegState_t decoder_state,
                       nvjpegImage_t *destination, cudaStream_t stream) {
  if (destination == nullptr) {
    return NVJPEG_STATUS_INVALID_PARAMETER;
  }
  conn_t *conn = connection_for_handle(handle);
  return lupine_rpc_nvjpegDecodeJpegDevice(conn, handle, decoder, decoder_state,
                                           destination, stream);
}

