    conn_t *conn, cusparseHandle_t handle, cusparseSpMMOpPlan_t *plan,
    cusparseOperation_t opA, cusparseOperation_t opB,
    cusparseConstSpMatDescr_t matA, cusparseConstDnMatDescr_t matB,
    cusparseDnMatDescr_t matC, cudaDataType computeType,
    cusparseSpMMOpAlg_t alg, const void *addOperationLtoirBuffer,
    size_t addOperationBufferSize, const void *mulOperationLtoirBuffer,
    size_t mulOperationBufferSize, const void *epilogueLtoirBuffer,
    size_t epilogueBufferSize, size_t *SpMMWorkspaceSize) {
  cusparseStatus_t return_value = rpc_error();
  uint8_t addOperationLtoirBuffer_null =
      addOperationLtoirBuffer == nullptr ? 1 : 0;
  uint8_t mulOperationLtoirBuffer_null =
      mulOperationLtoirBuffer == nullptr ? 1 : 0;
  uint8_t epilogueLtoirBuffer_null = epilogueLtoirBuffer == nullptr ? 1 : 0;
  if (conn == nullptr ||
      rpc_write_start_request(conn, RPC_cusparseSpMMOp_createPlan) < 0 ||
      rpc_write(conn, &handle, sizeof(cusparseHandle_t)) < 0 ||
      rpc_write(conn, &opA, sizeof(cusparseOperation_t)) < 0 ||
      rpc_write(conn, &opB, sizeof(cusparseOperation_t)) < 0 ||
      rpc_write(conn, &matA, sizeof(cusparseConstSpMatDescr_t)) < 0 ||
      rpc_write(conn, &matB, sizeof(cusparseConstDnMatDescr_t)) < 0 ||
      rpc_write(conn, &matC, sizeof(cusparseDnMatDescr_t)) < 0 ||
      rpc_write(conn, &computeType, sizeof(cudaDataType)) < 0 ||
      rpc_write(conn, &alg, sizeof(cusparseSpMMOpAlg_t)) < 0 ||
      rpc_write(conn, &addOperationBufferSize, sizeof(size_t)) < 0 ||
      rpc_write(conn, &addOperationLtoirBuffer_null, sizeof(uint8_t)) < 0 ||
      (!addOperationLtoirBuffer_null && addOperationBufferSize != 0 &&
       rpc_write(conn, addOperationLtoirBuffer, addOperationBufferSize) < 0) ||
      rpc_write(conn, &mulOperationBufferSize, sizeof(size_t)) < 0 ||
      rpc_write(conn, &mulOperationLtoirBuffer_null, sizeof(uint8_t)) < 0 ||
      (!mulOperationLtoirBuffer_null && mulOperationBufferSize != 0 &&
       rpc_write(conn, mulOperationLtoirBuffer, mulOperationBufferSize) < 0) ||
      rpc_write(conn, &epilogueBufferSize, sizeof(size_t)) < 0 ||
      rpc_write(conn, &epilogueLtoirBuffer_null, sizeof(uint8_t)) < 0 ||
      (!epilogueLtoirBuffer_null && epilogueBufferSize != 0 &&
       rpc_write(conn, epilogueLtoirBuffer, epilogueBufferSize) < 0) ||
      rpc_wait_for_response(conn) < 0 ||
      rpc_read(conn, plan, sizeof(cusparseSpMMOpPlan_t)) < 0 ||
      rpc_read(conn, SpMMWorkspaceSize, sizeof(size_t)) < 0 ||
      rpc_read(conn, &return_value, sizeof(return_value)) < 0 ||
      rpc_read_end(conn) < 0) {
    return rpc_error();
  }
  return return_value;
}

extern "C" cusparseStatus_t cusparseSpMMOp_createPlan(
    cusparseHandle_t handle, cusparseSpMMOpPlan_t *plan,
    cusparseOperation_t opA, cusparseOperation_t opB,
    cusparseConstSpMatDescr_t matA, cusparseConstDnMatDescr_t matB,
    cusparseDnMatDescr_t matC, cudaDataType computeType,
    cusparseSpMMOpAlg_t alg, const void *addOperationLtoirBuffer,
    size_t addOperationBufferSize, const void *mulOperationLtoirBuffer,
    size_t mulOperationBufferSize, const void *epilogueLtoirBuffer,
    size_t epilogueBufferSize, size_t *SpMMWorkspaceSize) {
  if (plan == nullptr || SpMMWorkspaceSize == nullptr) {
    return CUSPARSE_STATUS_INVALID_VALUE;
  }
  conn_t *conn = connection_for_handle(handle);
  cusparseStatus_t return_value = lupine_rpc_cusparseSpMMOp_createPlan(
      conn, handle, plan, opA, opB, matA, matB, matC, computeType, alg,
      addOperationLtoirBuffer, addOperationBufferSize, mulOperationLtoirBuffer,
      mulOperationBufferSize, epilogueLtoirBuffer, epilogueBufferSize,
      SpMMWorkspaceSize);
  if (return_value == CUSPARSE_STATUS_SUCCESS) {
    note_handle_owner(conn, *plan);
  }
  return return_value;
}

