static cusparseStatus_t lupine_rpc_cusparseLtMatmul(
    conn_t *conn, const cusparseLtHandle_t *handle,
    const cusparseLtMatmulPlan_t *plan, const void *alpha, const void *d_A,
    const void *d_B, const void *beta, const void *d_C, void *d_D,
    void *workspace, cudaStream_t *streams, int32_t numStreams) {
  cusparseStatus_t return_value = rpc_error();
  uint32_t alpha_width = alpha != nullptr && scalar_on_host(plan, "alpha")
                             ? static_cast<uint32_t>(sizeof(float))
                             : 0;
  uint32_t beta_width = beta != nullptr && scalar_on_host(plan, "beta")
                            ? static_cast<uint32_t>(sizeof(float))
                            : 0;
  uint8_t streams_null = streams == nullptr ? 1 : 0;
  if (conn == nullptr ||
      rpc_write_start_request(conn, RPC_cusparseLtMatmul) < 0 ||
      rpc_write(conn, handle, sizeof(void *)) < 0 ||
      rpc_write(conn, plan, sizeof(void *)) < 0 ||
      rpc_write(conn, &alpha_width, sizeof(alpha_width)) < 0 ||
      (alpha_width == 0 && rpc_write(conn, &alpha, sizeof(alpha)) < 0) ||
      (alpha_width != 0 && rpc_write(conn, alpha, alpha_width) < 0) ||
      rpc_write(conn, &d_A, sizeof(const void *)) < 0 ||
      rpc_write(conn, &d_B, sizeof(const void *)) < 0 ||
      rpc_write(conn, &beta_width, sizeof(beta_width)) < 0 ||
      (beta_width == 0 && rpc_write(conn, &beta, sizeof(beta)) < 0) ||
      (beta_width != 0 && rpc_write(conn, beta, beta_width) < 0) ||
      rpc_write(conn, &d_C, sizeof(const void *)) < 0 ||
      rpc_write(conn, &d_D, sizeof(void *)) < 0 ||
      rpc_write(conn, &workspace, sizeof(void *)) < 0 ||
      rpc_write(conn, &numStreams, sizeof(int32_t)) < 0 ||
      rpc_write(conn, &streams_null, sizeof(uint8_t)) < 0 ||
      (!streams_null && numStreams * sizeof(cudaStream_t) != 0 &&
       rpc_write(conn, streams, numStreams * sizeof(cudaStream_t)) < 0) ||
      rpc_wait_for_response(conn) < 0 ||
      rpc_read(conn, &return_value, sizeof(return_value)) < 0 ||
      rpc_read_end(conn) < 0) {
    return rpc_error();
  }
  return return_value;
}

extern "C" cusparseStatus_t
cusparseLtMatmul(const cusparseLtHandle_t *handle,
                 const cusparseLtMatmulPlan_t *plan, const void *alpha,
