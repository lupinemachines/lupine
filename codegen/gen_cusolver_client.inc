extern "C" cusolverStatus_t
cusolverRfSetupHost(int n, int nnzA, int *h_csrRowPtrA, int *h_csrColIndA,
                    double *h_csrValA, int nnzL, int *h_csrRowPtrL,
                    int *h_csrColIndL, double *h_csrValL, int nnzU,
                    int *h_csrRowPtrU, int *h_csrColIndU, double *h_csrValU,
                    int *h_P, int *h_Q, cusolverRfHandle_t handle) {
  if (nnzA < 0 || nnzA < 0 || nnzL < 0 || nnzL < 0 || nnzU < 0 || nnzU < 0 ||
      n < 0 || n < 0 || (n + 1 != 0 && h_csrRowPtrA == nullptr) ||
      (nnzA * sizeof(int) != 0 && h_csrColIndA == nullptr) ||
      (nnzA * sizeof(double) != 0 && h_csrValA == nullptr) ||
      (n + 1 != 0 && h_csrRowPtrL == nullptr) ||
      (nnzL * sizeof(int) != 0 && h_csrColIndL == nullptr) ||
      (nnzL * sizeof(double) != 0 && h_csrValL == nullptr) ||
      (n + 1 != 0 && h_csrRowPtrU == nullptr) ||
      (nnzU * sizeof(int) != 0 && h_csrColIndU == nullptr) ||
      (nnzU * sizeof(double) != 0 && h_csrValU == nullptr) ||
      (n * sizeof(int) != 0 && h_P == nullptr) ||
      (n * sizeof(int) != 0 && h_Q == nullptr)) {
    return CUSOLVER_STATUS_INVALID_VALUE;
  }
  conn_t *conn = connection_for_handle(handle);
  cusolverStatus_t return_value = lupine_rpc_cusolverRfSetupHost(
      conn, n, nnzA, h_csrRowPtrA, h_csrColIndA, h_csrValA, nnzL, h_csrRowPtrL,
      h_csrColIndL, h_csrValL, nnzU, h_csrRowPtrU, h_csrColIndU, h_csrValU, h_P,
      h_Q, handle);
  if (return_value == CUSOLVER_STATUS_SUCCESS) {
    note_rf_dims(handle, n, 1);
  }
  return return_value;
}

