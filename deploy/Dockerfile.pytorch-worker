# syntax=docker/dockerfile:1.7
# The torch worker image: a CUDA PyTorch of one release plus the LUPINE torch
# backend extension built against it. The client shims are not baked in; the
# worker fetches the bundle its server publishes at start (linux/arm64 for
# the Apple silicon guest, linux/amd64 elsewhere).
ARG PYTHON_VERSION=3.12
ARG TORCH_VERSION=2.12.1
ARG TORCH_CUDA_INDEX=cu130

FROM python:${PYTHON_VERSION}-slim-trixie AS build
ARG TORCH_VERSION
ARG TORCH_CUDA_INDEX
RUN apt-get update \
    && apt-get install -y --no-install-recommends g++ libnghttp2-dev \
    && rm -rf /var/lib/apt/lists/*
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --index-url "https://download.pytorch.org/whl/${TORCH_CUDA_INDEX}" \
        "torch==${TORCH_VERSION}" \
    && pip install ninja setuptools numpy
WORKDIR /src
COPY . /src
# Editable so the in-place extension build lands inside the package.
RUN pip install --no-deps -e /src/python \
    && cd /src/python/lupine/_backend \
    && python setup.py build_ext --inplace \
    && rm -rf build

FROM python:${PYTHON_VERSION}-slim-trixie
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates libnghttp2-14 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=build /usr/local/bin/lupine-torch-worker /usr/local/bin/lupine-torch-worker
COPY --from=build /src/python /src/python
EXPOSE 14834
ENTRYPOINT ["lupine-torch-worker"]
CMD ["--listen", "0.0.0.0:14834"]
